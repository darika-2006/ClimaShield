# ClimaShield TN - Backend Server Environment Configuration

PORT=5000
NODE_ENV=development

# Supabase / PostgreSQL Connection URI (with PostGIS support)
DATABASE_URL=postgresql://postgres.your-project-id:your_db_password@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres

# Direct Connection Parameters (Optional / Fallback)
host=aws-0-ap-southeast-2.pooler.supabase.com
port=5432
database=postgres
user=postgres.your-project-id

# External APIs & Client Config
VITE_WEATHER_API=your_openweathermap_api_key
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_API_BASE_URL=http://localhost:5000/api/v1
# GEMINI_API_KEY=your_gemini_api_key
